#bmi计算公式 （这个竟然真的能用）
def colculate_BMI(c,d):

    BMI=d/(c**2)
    if BMI <= 18.5:
        sos="偏瘦"
    elif BMI <= 25:
        sos="正常"
    elif BMI <= 30:
        sos="偏胖"
    else :
        sos="肥胖"

    return sos,BMI



c=float(input("请输入你的身高："))
d=float(input("请输入你的体重："))

sos,BMI=colculate_BMI(c,d)

print(f"你的BMI分类为{sos}")
print(BMI)

