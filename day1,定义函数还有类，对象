#关于学生的成绩

class student:
    def __init__(self,name,student_ID,chinese,math,english):
        self.name=name
        self.student_ID=student_ID
        self.chinese = chinese
        self.math = math
        self.english = english

    def what(self):
        print(self.name)
        print(self.student_ID)
        print(self.chinese)
        print(self.math)
        print(self.english)


name=input("你的名字:")
student_ID=input("你的学号：")
chinese=input("语文成绩：")
math=input("数学成绩：")
english=input("英语成绩：")

me=student(name,student_ID,chinese,math,english)

where=input("输入a打印成绩单：")

if where=="a" :
    me.what()

else :
    print("再见。")


